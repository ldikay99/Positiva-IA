# Copiar como .env y ajustar las rutas de esta máquina.

# Credenciales de Vertex AI: el ADC de gcloud (gcloud auth application-default login)
# o una llave de cuenta de servicio con permiso sobre Vertex AI.
# Windows: C:/Users/<usuario>/AppData/Roaming/gcloud/application_default_credentials.json
RUTA_CREDENCIALES=

# Carpeta con los correos descargados: una subcarpeta por correo con mensaje.json y adj/.
RUTA_BANDEJA=

GCP_PROJECT=positiva-sgda-prd-416417
PUERTO=8080
TRABAJADORES_MAX=8
