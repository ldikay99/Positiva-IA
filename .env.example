# Copiar como .env y ajustar las rutas de esta máquina.

# Credenciales de Vertex AI: el ADC de gcloud (gcloud auth application-default login)
# o una llave de cuenta de servicio con permiso sobre Vertex AI.
# Windows: C:/Users/<usuario>/AppData/Roaming/gcloud/application_default_credentials.json
RUTA_CREDENCIALES=

# Carpeta con los correos descargados: una subcarpeta por correo con mensaje.json y adj/.
RUTA_BANDEJA=

# Obligatorio: id del proyecto de Google Cloud con Vertex AI (Gemini) y, si no se define
# PROYECTO_SECRETOS, también el de Secret Manager para los buzones reales. Vera no trae
# uno por defecto: sin él, docker compose no arranca y lo que llama a Vertex falla con el motivo.
GCP_PROJECT=
# Opcional: proyecto de Secret Manager con las credenciales de los buzones (por defecto, GCP_PROJECT).
# PROYECTO_SECRETOS=
PUERTO=8080
TRABAJADORES_MAX=8

# Opcional: el estado de la plataforma en PostgreSQL (docs/PRODUCCION.md › 6b). Sin esto, en archivos.
# Las claves van en archivos de RUTA_SECRETOS_BD (migrador, app, kek), nunca aquí.
# RUTA_SECRETOS_BD=./datos/secretos-bd
# PUERTO_BD=5482
# VERA_ORGANIZACION=principal
