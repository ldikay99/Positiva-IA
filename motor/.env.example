# Copiar a .env para desarrollo local. En produccion los valores vienen de
# Secret Manager con prefijo PQRD_.

# Microsoft Graph
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
OUTLOOK_REFRESH_TOKEN=
OUTLOOK_FOLDER_ID=

# Redis (dedup por hash)
REDIS_PASSWORD=

# Supabase (auditoria)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SGDEA
SGDEA_CLIENT_SECRET=
SGDEA_PASSWORD=

# MODO_TEST=true: lee normal pero no escribe (no radica, etiqueta, mueve,
# reenvia, ni toca Redis/Supabase). Por defecto es false, y las URLs de backend
# y el buzon estan hardcodeados en settings.py e iguales en los tres ambientes:
# sin esto se escribe en produccion desde cualquier entorno.
MODO_TEST=true
TEST_OUTPUT_DIR=salidas_prueba

# MODO_TEST apaga tambien las CONSULTAS de deduplicacion (hilo y asunto), que
# son de solo lectura, para poder reprocesar los mismos correos. El efecto es
# que una corrida de prueba termina en "0 duplicados" sin haber comprobado
# nada. Con esto en true las consultas se hacen y la deduplicacion queda
# validada contra el buzon real; sigue sin escribirse nada. A cambio, los
# correos ya radicados se saltan y no sirve para reprocesar.
DEDUP_EN_PRUEBAS=false

# Vertex AI por ADC: gcloud auth application-default login
# GCP_PROJECT=
# GCP_LOCATION=us-east1
